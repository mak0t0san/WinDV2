<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDV.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20,0,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Style="{StaticResource SubtleButtonStyle}" Click="Cancel_Click" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="4" MaxWidth="820" HorizontalAlignment="Stretch">
                <TextBlock Text="Camcorder" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="DeckControlSwitch" Header="Let WinDV run the tape"
                                      OnContent="On" OffContent="Off" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="REC starts the tape if it isn't playing, and Record to tape puts the camcorder into record by itself. Turn this off to operate the camcorder by hand. The transport buttons work either way." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Capture from tape" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <RadioButtons x:Name="AviTypeButtons" Header="AVI format">
                            <RadioButton Content="Type 1: one interleaved DV stream (iavs)" />
                            <RadioButton Content="Type 2: separate video and audio streams (vids + auds). Most editors prefer this." />
                        </RadioButtons>

                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="ThresholdBox" Header="New file on a time jump of (s)"
                                       Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Compact"
                                       ToolTipService.ToolTip="Start a new file when the camcorder's recording time jumps (a new scene). 0 turns this off." />
                            <NumberBox x:Name="MaxFramesBox" Grid.Column="1" Header="Max frames per file"
                                       Minimum="10" Maximum="1000000" SpinButtonPlacementMode="Compact"
                                       ToolTipService.ToolTip="22 500 frames is 15 minutes of PAL video." />
                            <NumberBox x:Name="EveryNthBox" Grid.Column="2" Header="Keep every Nth frame"
                                       Minimum="1" Maximum="1000000" SpinButtonPlacementMode="Compact"
                                       ToolTipService.ToolTip="1 keeps every frame. Higher values make time-lapse captures." />
                        </Grid>

                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <ToggleSwitch x:Name="SignalLossSwitch" Header="Stop when the signal ends"
                                              Toggled="SignalLossSwitch_Toggled" />
                                <NumberBox x:Name="SignalLossBox" Header="after (seconds)" Minimum="1" Maximum="3600"
                                           SpinButtonPlacementMode="Compact" MinWidth="140" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Finishes the capture on its own when no video has arrived for this long, for example at the end of the recorded part of a tape. Leave it off if your tapes have blank gaps between recordings." />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DateFormatBox" Header="Date and time in file names" IsEditable="True"
                                      HorizontalAlignment="Stretch" TextSubmitted="DateFormatBox_TextSubmitted"
                                      SelectionChanged="DateFormatBox_SelectionChanged" />
                            <ComboBox x:Name="DigitsBox" Grid.Column="1" Header="Numbering digits"
                                      HorizontalAlignment="Stretch" SelectionChanged="DigitsBox_SelectionChanged" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Example file name" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ExampleText" FontFamily="Cascadia Mono,Consolas" IsTextSelectionEnabled="True" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Uses strftime codes such as %Y year, %m month, %d day, %H hour, %M minute, %S second. The date comes from the tape where available." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Record to tape" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBox x:Name="PrefixBox" Header="Leader AVI (recorded before the files)"
                                 PlaceholderText="Optional, e.g. a few seconds of black" />
                        <TextBox x:Name="SuffixBox" Header="Trailer AVI (recorded after the files)"
                                 PlaceholderText="Optional" />
                        <ToggleSwitch x:Name="RecordPreviewSwitch" Header="Show the picture while recording" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="UpdateCheckSwitch" Header="Tell me when a new version is out"
                                      OnContent="On" OffContent="Off" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="At most once a day, WinDV asks GitHub for the number of its latest version. Nothing about you or your videos is sent, and nothing is downloaded or installed without you." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <TextBlock x:Name="ValidationText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       VerticalAlignment="Center" />
            <Button Content="Cancel" Click="Cancel_Click" MinWidth="100" />
            <Button Content="Save" Click="Save_Click" MinWidth="100" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
